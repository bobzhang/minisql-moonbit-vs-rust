{
  "model": "claude-opus-5-5",
  "effort": "high",
  "runs_dir": "~/minisql-bench-runs",
  "milestones": [
    [1, "Core pipeline"],
    [2, "Expressions and scalar functions"],
    [3, "Query shaping, DML and constraints"],
    [4, "Aggregation and date/time"],
    [5, "Joins, subqueries and compound queries"],
    [6, "Schema, indexes and transactions"],
    [7, "CTEs and window functions"],
    [8, "Reading SQLite database files"],
    [9, "Writing SQLite database files"]
  ],
  "session": {
    "tools": "Bash,Read,Edit,Write",
    "max_nudges": 2,
    "session_timeout_hours": 6,
    "rate_limit_initial_wait_s": 900,
    "rate_limit_max_wait_s": 3600
  },
  "arms": {
    "rust": {
      "language": "Rust",
      "template": "rust",
      "primer": "RUST.md",
      "build": "cargo build --release",
      "binary": "target/release/minisql",
      "io_module": "src/io.rs",
      "source_ext": [".rs"],
      "test_file_patterns": ["tests/"],
      "ignore_dirs": ["target", "tests", "tools", ".git"]
    },
    "moonbit": {
      "language": "MoonBit",
      "template": "moonbit",
      "primer": "MOONBIT.md",
      "build": "moon build --release",
      "binary": "_build/native/release/build/cmd/main/main.exe",
      "io_module": "io/",
      "source_ext": [".mbt"],
      "test_file_patterns": ["_test.mbt", "_wbtest.mbt"],
      "ignore_dirs": ["_build", ".mooncakes", "tests", "tools", ".git"]
    },
    "moonbit-noprimer": {
      "language": "MoonBit",
      "template": "moonbit",
      "primer": null,
      "build": "moon build --release",
      "binary": "_build/native/release/build/cmd/main/main.exe",
      "io_module": "io/",
      "source_ext": [".mbt"],
      "test_file_patterns": ["_test.mbt", "_wbtest.mbt"],
      "ignore_dirs": ["_build", ".mooncakes", "tests", "tools", ".git"]
    }
  }
}
